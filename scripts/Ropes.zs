##enables conversion of supplementaries ropes to farmers delight ropes and vice versa

craftingTable.addShapeless("supplementaries_rope_to_farmers", <item:farmersdelight:rope> * 1, 
[<item:supplementaries:rope>]);

craftingTable.addShapeless("farmers_rope_to_supplementaries", <item:supplementaries:rope> * 1, 
[<item:farmersdelight:rope>]);
