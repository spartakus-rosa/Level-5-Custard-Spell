## allows conversion of supplementaries flutes to immersive melodies flutes and vice versa

craftingTable.addShapeless("supplementaries_flute_to_immersive_melodies", <item:immersive_melodies:flute> * 1, 
[<item:supplementaries:flute>]);

craftingTable.addShapeless("immersive_melodies_flute_to_supplementaries", <item:supplementaries:flute> * 1, 
[<item:immersive_melodies:flute>]);

